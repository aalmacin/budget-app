# Supabase — required for app runtime
# Get these from your Supabase project dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — used by migration tooling and admin scripts.
# NEVER read this from app code (no server actions, no API routes).
# Keep this OUT of the client bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
