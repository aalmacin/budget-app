# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real values.
# See specs/001-setup-supabase/quickstart.md for how to obtain these.

# --- Required for the app ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Required for Playwright E2E tests (npm run test:e2e) ---
# Two user accounts pre-provisioned by an administrator in the Supabase dashboard.
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
